{
  "version": 2,
  "buildCommand": "cd banking_frontend && npm install && npm run build",
  "outputDirectory": "banking_frontend/build",
  "functions": {
    "banking_api/main.py": {
      "runtime": "python3.12"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "banking_api/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/banking_frontend/build/index.html"
    }
  ]
}