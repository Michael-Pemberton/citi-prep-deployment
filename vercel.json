{
  "version": 2,
  "builds": [
    {
      "src": "banking_api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "banking_frontend/build/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "banking_api/main.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/banking_frontend/build/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/banking_frontend/build/index.html"
    }
  ]
}